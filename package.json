{
  "name": "xiaobu",
  "private": true,
  "version": "1.0.0-m1",
  "type": "module",
  "description": "小卜 · AI 情绪陪伴 / 掷币仪式 · M1 骨架",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/export-tokens.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "node scripts/export-tokens.mjs",
    "preview": "vite preview",
    "tokens": "node scripts/export-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:scene": "node scripts/preview-scene.mjs",
    "check:art": "node scripts/check-art-geometry.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "lint": "eslint src tests scripts --max-warnings 0",
    "gates": "node ci/gates/run-all.mjs",
    "ci": "node ci/ci.mjs",
    "bundle:baseline": "node scripts/record-bundle-baseline.mjs",
    "server:dev": "python -m uvicorn server.main:app --reload --host 127.0.0.1 --port 8000",
    "server:deps": "python -m pip install -r server/requirements.txt",
    "server:test": "python server/test_contract.py"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.2",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "pinia": "^2.2.2",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@eslint/js": "^9.9.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
